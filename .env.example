DATABASE_TYPE=postgres
# Host must match the postgres service name in docker-compose.yml
DATABASE_URL=postgresql://camp-log:camp-log@postgres:5432/camp-log
MODE=production
PORT=3000

# Used by the postgres service in docker-compose.yml - keep these in sync with DATABASE_URL above
POSTGRES_USER=camp-log
POSTGRES_PASSWORD=camp-log
POSTGRES_DB=camp-log

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OPENCAGE_API_KEY=
